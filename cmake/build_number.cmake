# Bumps the persistent build counter and (re)generates BuildNumber.h.
# Invoked at build time by the Mosaic_build_number target:
#   cmake -DBUILD_NUMBER_FILE=<counter file> -DOUTPUT_HEADER=<header> -P build_number.cmake
#
# The counter file lives in the source tree so the number keeps climbing
# across clean builds; the generated header is included by the app to show
# the build number in the title bar.

set(_counter 0)

if(EXISTS "${BUILD_NUMBER_FILE}")
    file(READ "${BUILD_NUMBER_FILE}" _raw)
    string(STRIP "${_raw}" _raw)
    if(_raw MATCHES "^[0-9]+$")
        set(_counter "${_raw}")
    endif()
endif()

math(EXPR _counter "${_counter} + 1")

file(WRITE "${BUILD_NUMBER_FILE}" "${_counter}\n")

get_filename_component(_outDir "${OUTPUT_HEADER}" DIRECTORY)
file(MAKE_DIRECTORY "${_outDir}")

file(WRITE "${OUTPUT_HEADER}"
"#pragma once

// Auto-generated by cmake/build_number.cmake on every build - do not edit.
#define Mosaic_BUILD_NUMBER ${_counter}
")
